# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority&appName=<appname>
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/moviebooking?retryWrites=true&w=majority&appName=Cluster0

# Server Port (Render will provide this automatically)
PORT=5000

# Frontend URL (Update with your Vercel deployment URL in production)
CLIENT_URL=http://localhost:5173

# JWT Secret Key (Generate a strong random key for production)
JWT_SECRET=your-secret-key-change-this-in-production
